#!/bin/sh
# MediaPickerKMP Git Commit-Msg Hook
# Enforces Conventional Commit format: <type>(<scope>): <subject>

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMIT_MSG_FILE="$1"

if [ ! -f "$COMMIT_MSG_FILE" ]; then
    echo "${RED}[ERROR] Commit message file not found.${NC}"
    exit 1
fi

COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

# Allow merge commits
if echo "$COMMIT_MSG" | grep -q -E "^Merge branch"; then
    exit 0
fi

# Allow release tags / fixup / squash
if echo "$COMMIT_MSG" | grep -q -E "^(fixup!|squash!|Release v[0-9]+)"; then
    exit 0
fi

# Conventional Commit Regex
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
CONVENTIONAL_REGEX="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_.-]+\))?(!)?:\s+[A-Za-z0-9].+"

if ! echo "$COMMIT_MSG" | grep -q -E "$CONVENTIONAL_REGEX"; then
    echo ""
    echo "${RED}❌ Invalid commit message format!${NC}"
    echo ""
    echo "Your commit message was:"
    echo "  ${YELLOW}\"$COMMIT_MSG\"${NC}"
    echo ""
    echo "MediaPickerKMP enforces Conventional Commits standard:"
    echo "  <type>(<optional scope>): <description>"
    echo ""
    echo "Allowed types:"
    echo "  ${GREEN}feat${NC}     : A new feature or public API capability"
    echo "  ${GREEN}fix${NC}      : A bug fix"
    echo "  ${GREEN}docs${NC}     : Documentation updates (README, docs, architecture)"
    echo "  ${GREEN}refactor${NC} : Code change that neither fixes a bug nor adds a feature"
    echo "  ${GREEN}perf${NC}     : A code change that improves performance"
    echo "  ${GREEN}test${NC}     : Adding or updating tests"
    echo "  ${GREEN}build${NC}    : Changes that affect the build system or Gradle dependencies"
    echo "  ${GREEN}ci${NC}       : Changes to CI configuration files and scripts (GitHub Actions)"
    echo "  ${GREEN}chore${NC}    : Routine tasks, maintenance, formatting, dependencies"
    echo "  ${GREEN}revert${NC}   : Reverting a previous commit"
    echo ""
    echo "Examples:"
    echo "  feat: add media picker"
    echo "  fix(android): resolve android gallery issue"
    echo "  docs: update installation guide"
    echo "  refactor: improve repository architecture"
    echo "  test: add metadata extractor tests"
    echo "  chore: update dependencies"
    echo ""
    exit 1
fi

echo "${GREEN}✅ Commit message follows Conventional Commits!${NC}"
exit 0
