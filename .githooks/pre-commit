#!/bin/sh
# MediaPickerKMP Git Pre-Commit Hook
# Validates staged files for secrets, prohibited artifacts, formatting, and syntax errors.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🔍 Running pre-commit validation..."

# 1. Collect staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "ℹ️ No staged files to check."
    exit 0
fi

FAILED=0

# 2. Check for prohibited sensitive and build artifacts
echo "  [1/5] Checking for prohibited files (.jks, .keystore, .apk, .hprof, etc.)..."
for file in $STAGED_FILES; do
    case "$file" in
        *.jks|*.keystore|*.p12|*.pfx|*.hprof|*.apk|*.aab|local.properties)
            echo "${RED}[ERROR] Prohibited file staged for commit: $file${NC}"
            FAILED=1
            ;;
    esac
done

# 3. Check for unresolved merge conflict markers
echo "  [2/5] Checking for merge conflict markers..."
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        if grep -q -E "^(<<<<<<<|=======|>>>>>>>)" "$file" 2>/dev/null; then
            echo "${RED}[ERROR] Merge conflict marker detected in: $file${NC}"
            FAILED=1
        fi
    fi
done

# 4. Secret detection (Gitleaks if installed, or native regex scanner)
echo "  [3/5] Scanning staged changes for credentials and secrets..."
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --redact --config=.gitleaks.toml --verbose; then
        echo "${RED}[ERROR] Gitleaks detected secrets in staged changes!${NC}"
        FAILED=1
    fi
else
    # Native lightweight secret scanning fallback (Never prints secret content)
    DIFF_CONTENT=$(git diff --cached)
    if echo "$DIFF_CONTENT" | grep -q -E "(-----BEGIN (RSA|EC|OPENSSH|DSA|PGP) PRIVATE KEY-----|AIza[0-9A-Za-z\\-_]{35}|ghp_[0-9a-zA-Z]{36}|github_pat_[0-9a-zA-Z_]{82}|AKIA[0-9A-Z]{16}|xox[baprs]-[0-9a-zA-Z]{10,48})"; then
        echo "${RED}[ERROR] Potential private key or API token detected in staged diff!${NC}"
        echo "${YELLOW}Hint: Remove the secret from staged changes. Never commit real credentials.${NC}"
        FAILED=1
    fi
fi

# 5. File syntax and formatting validation
echo "  [4/5] Checking file whitespace and trailing newlines..."
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        case "$file" in
            *.kt|*.kts|*.json|*.yaml|*.yml|*.xml)
                # Check for trailing whitespace
                if grep -q -E "[[:space:]]+$" "$file" 2>/dev/null; then
                    echo "${YELLOW}[WARN] Trailing whitespace detected in: $file${NC}"
                fi
                # Check for trailing newline
                if [ -s "$file" ] && [ "$(tail -c 1 "$file")" != "" ]; then
                    echo "${RED}[ERROR] Missing final newline in: $file${NC}"
                    FAILED=1
                fi
                ;;
        esac
    fi
done

# 6. Kotlin Linting (if ktlint CLI is installed)
echo "  [5/5] Checking Kotlin files..."
KT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(kt|kts)$' || true)
if [ -n "$KT_FILES" ] && command -v ktlint >/dev/null 2>&1; then
    if ! ktlint --editorconfig=.editorconfig --relative $KT_FILES; then
        echo "${RED}[ERROR] ktlint detected formatting/linting issues.${NC}"
        FAILED=1
    fi
fi

if [ $FAILED -ne 0 ]; then
    echo ""
    echo "${RED}❌ Pre-commit validation failed! Please fix the errors above before committing.${NC}"
    echo "Tip: Run 'git diff --cached' to review your staged changes."
    exit 1
fi

echo "${GREEN}✅ All pre-commit checks passed successfully!${NC}"
exit 0
